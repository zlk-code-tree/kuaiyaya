# 第一期本机运行。昆哥 Mac 上可复用已有 Docker 容器 mysql8（端口 3306）。
# 复制为本目录 .env 后按实际账号修改。不要把真实令牌提交进仓库。

# 监听地址
HTTP_ADDR=127.0.0.1:8080

# MySQL 8 连接串（go-sql-driver 格式）
# 请先在 mysql8 容器中建库，例如：
#   docker exec -it mysql8 mysql -uroot -p -e "CREATE DATABASE IF NOT EXISTS kuaiyaya CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;"
DATABASE_URL=root:password@tcp(127.0.0.1:3306)/kuaiyaya?parseTime=true&loc=UTC&charset=utf8mb4,utf8&timeout=5s

# 管理接口与管理页共用，至少 32 字节随机串
ADMIN_API_TOKEN=please-change-me-to-a-long-random-token

# 启动时是否自动执行迁移（本机开发建议 true；生产应由独立 migrate 命令跑 DDL）
AUTO_MIGRATE=true

LOG_LEVEL=info

# 若反代挂在子路径（如 http://IP/kuaiyaya），填写 /kuaiyaya，管理页跳转才会带此前缀
PUBLIC_BASE_PATH=

# 可选：版本信息 JSON 路径。留空时客户端显示暂无发布信息。
# 先上传可访问的安装包，再原子替换该文件；格式参考 releases.example.json。
UPDATE_MANIFEST_PATH=
